# ==========================================
# CodeFoundry Environment Configuration Template
# ==========================================

# --- Django Core Settings ---
SECRET_KEY=your-production-secret-key-here-minimum-50-chars
DEBUG=False
ALLOWED_HOSTS=app.codefoundry.dev,api.codefoundry.dev,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.codefoundry.dev,http://localhost:5173

# --- PostgreSQL Database (Option 1: DATABASE_URL or Option 2: DB_*) ---
# DATABASE_URL=postgresql://codefoundry_user:your-secure-password@127.0.0.1:5432/codefoundry
DB_NAME=codefoundry
DB_USER=codefoundry_user
DB_PASSWORD=your-secure-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Email Configuration (Production SMTP / Console Dev) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@codefoundry.dev

# --- Frontend SPA (Vite) ---
VITE_API_BASE_URL=https://api.codefoundry.dev/api

# --- HTTPS / Reverse Proxy / Security Headers ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
