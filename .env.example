# ==========================================
# DevForge Environment Configuration Template
# ==========================================

# --- Django Core Settings ---
SECRET_KEY=your-production-secret-key-here-minimum-50-chars
DEBUG=False
ALLOWED_HOSTS=app.devforge.com,api.devforge.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.devforge.com,http://localhost:5173

# --- PostgreSQL Database ---
DB_NAME=codefoundry
DB_USER=codefoundry_user
DB_PASSWORD=your-secure-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis & Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Frontend SPA (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- HTTPS / Reverse Proxy (Optional / Production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
